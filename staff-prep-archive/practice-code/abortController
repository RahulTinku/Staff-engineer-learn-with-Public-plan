import React, {useEffect, useState} from 'react'

const useDebounce = (searchItem, delay) => {
	const [data, setData] = useState(null)
	
	useEffect(() => {
		const interval = setTimeout(() => {
			setData(searchItem)
		}, delay)

		return () => {
			clearTimeout(interval)
		}
	}, [searchItem, delay])

	return data
}


