			try{
				setError(null)
				setLoading(true)

				const res = await fetch(api, {signal: controller.signal})

				if(!res.ok) throw new Error(`HTTP error status ${res.status}`)

				const json = await res.json()
				setData(json)
			}catch(err) {
				if(err.name = 'AbortError') return
				setError(err.message)
			}finally{
				setLoading(false)
			}
		}

		getData()

		return () => controller.abort()

	}, [api])

	return {data, error, loading}
}


// Filter pannel
const FilterContext = createContext(null)

const useFilter = () => {
	const context = useContext(FilterContext);
	if(!context) throw new Error('FilterPannel sub-component must be inside <FilterPannel>')
	return context;
}

const FilterPannel = ({children}) => {
	const [isOpen, setIsOpen] = useState(false)
	const [selected, setSelected] = useState(null)

	return(
		<FilterContext.Provider value={{iseOpen, setIsOpen, selected, setSelected}}>
			{children}
		<FilterContext.Provider>
	)
}

FilterPannel.Toggel = ({children}) => {
	const {isOpen, setIsOpen} = useFilter()
	return(
		<button onClick={() => setIsOpen(!isOpen)}
			{children} {isOpen ? 'up' : 'down'}
		</button>
	)
}	

FilterPannel.Options = ({children}) => {
	const {isOpen} = useFilter()
	if(!isOpen) return null

