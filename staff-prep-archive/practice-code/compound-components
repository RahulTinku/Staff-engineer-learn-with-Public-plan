import React, {createContext, useContext, useState, useEffect, useCallback} from 'react'

const NotificationContext = createContext()

const NotificationProvider = ({children}) = {
	
	const [notification, setNotification] = useState([]);

	const notify = useCallback((message, type: 'info') => {
		const id = Date.now() // unique id for notification

		setNotification(prev => [...prev, {id, message, type}])
	},[])

	const dismiss = useCallback((id) => {
		setNotification(prev => prev.filter(i => i.id !== id))
	},[])


	return(
		<NotificationContext.provider value={{notify, dismiss}}>
			{children}
			<NotificationContainer notification={notification} onDismiss={dismiss}>
		</NotificationContext.provider>
	)
}

const useNotification = () => {
	const context = useContext(NotificationContext)

	if(!context) throw new Error('call within Notification Provider')

	return context
}

const NotificationItem =({message, onDismiss}) => {
	const {id, message, onDismiss} = useNotification()

	useEffect(() => {
		const timer = setTimeout(() => {
		onDismiss(id)
		}, 3000)

		return () => clearTimeout(timer)
	}, [id, onDismiss])

	return(
		<div>
			<span>{message}</span>
			<button onClick={() => onDismiss(id)}> X </button>
		</div>
	)
}

const NotificationContainer = ({notification, onDismiss}) => {
	
	if(notification.length === 0) return;

	return(
		{notification.map((n) => 
			<NotificationItem 
				key={n.id}
				message={n}
				onDismiss={onDismiss}
			/>
		)}
		
		}
	)
}




