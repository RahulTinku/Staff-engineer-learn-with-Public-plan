import React, {createContext, useContext, useState} from 'react'

const SelectContext = createContext() // create context for shared state.

// parent own and provide state
const Select = ({children}) => {
	const [isOpen, setIsOpen] = useState(false)
	const [selectedValue, setSelectedValue] = useState(null)

	return(
		<SelectContext.provider value={{
			isOpen,
			setIsOpen,
			selectedValue,
			setSelectedValue
		}}>
			<div className="selected-container">{children}</div>
		</SelectContext.provider>
	)
}

//setp 3  - custom hook to consume context cleanly

const useSelect = () => {
	const context = useContext(SelectContext)
	if(!context){
		throw new Error('useSelect must be within Select component')
	}
	return context;
}

// step 4- sub-component reads from context

Select.Trigger = ({children}) => {
	const {isOpen, setIsOpen, selectedValue} = useSelect();

	return(
		<button onClick={() => setIsOpen(!isOpen)} className={select-trigger}>{selectedValue || children} <span>{isOpen ? '▲' : '▼'}</span></button>
	)
}

Select.Option = ({value, children}) => {
	const {setSelectedValue, SetIsOpen, selectedValue} = useSelect()

	const isSelected = selectedValue === value;

	return(
		<li onClick={() => {
			setSelectedValue(value) 
			setIsOpen(false)
			}
		className={isSelected ? 'selected' : ''}
		}>
		{children}
		</li>
	)
}

export default Select;



<Select>
	<Select.Trigger>Choose Fruit</Select.Trigger>
	<Select.Option>
		<Select.Option value='apple'>Apple</Select.Option>
		<Select.Option value='banana'>Banana</Select.Option>
</Select>



